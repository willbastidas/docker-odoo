<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_discount_rule_tree" model="ir.ui.view">
        <field name="name">account.discount.rule.tree</field>
        <field name="model">account.discount.rule</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="tipo_cliente"/>
                <field name="descuento"/>
            </tree>
        </field>
    </record>

    <record id="action_account_discount_rules" model="ir.actions.act_window">
        <field name="name">Políticas de Descuento</field>
        <field name="res_model">account.discount.rule</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_discount_rules_config" 
              name="Políticas de Descuento" 
              parent="account.menu_finance_configuration" 
              action="action_account_discount_rules" 
              sequence="100"/>
</odoo>