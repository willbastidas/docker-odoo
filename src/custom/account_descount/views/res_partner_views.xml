<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_discount_page" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.discount.page</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Políticas de Venta" name="politicas_venta">
                    <group>
                        <group string="Clasificación">
                            <field name="tipo_cliente" string="Tipo de Cliente"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>