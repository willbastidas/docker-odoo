<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_apply_discount_wizard_form" model="ir.ui.view">
        <field name="name">account.move.apply.discount.wizard.form</field>
        <field name="model">account.move.apply.discount.wizard</field>
        <field name="arch" type="xml">
            <form string="Aplicar Descuento">
                <group>
                    <field name="discount_percent"/>
                </group>
                <footer>
                    <button string="Aplicar" type="object" name="apply_discount" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>