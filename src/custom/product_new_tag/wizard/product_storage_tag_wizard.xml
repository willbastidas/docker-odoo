<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_server_product_storage_tag_wizard" model="ir.actions.server">
        <field name="name">Etiquetado de Almacenamiento</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = env.ref('product_new_tag.action_product_storage_tag_wizard').read()[0]
        </field>
    </record>

    <record id="action_product_storage_tag_wizard" model="ir.actions.act_window">
        <field name="name">Etiquetado Masivo</field>
        <field name="res_model">product.storage.tag.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_product_storage_tag_wizard_form" model="ir.ui.view">
        <field name="name">product.storage.tag.wizard.form</field>
        <field name="model">product.storage.tag.wizard</field>
        <field name="arch" type="xml">
            <form string="Gestionar Etiquetas Masivamente">
                <sheet>
                    <group>
                        <field name="storage_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </group>
                    <separator string="Productos Seleccionados"/>
                    <p class="text-muted">
                        Si seleccionaste productos en la lista, aparecerán aquí. También puedes agregarlos manualmente.
                    </p>
                    <field name="product_ids" widget="many2many_tags"/>
                </sheet>
                <footer>
                    <button string="Aplicar Etiquetas" name="action_apply_tags" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>