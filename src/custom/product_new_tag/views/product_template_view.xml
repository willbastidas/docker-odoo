<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_storage_tags" model="ir.ui.view">
        <field name="name">product.template.form.inherit.storage.tags</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="storage_tag_ids" 
                    widget="many2many_tags" 
                    options="{'color_field': 'color'}"
                    placeholder="Seleccionar etiquetas de almacenamiento..."/>
            </xpath>
        </field>
    </record>
</odoo>