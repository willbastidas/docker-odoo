<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <function model="stock.warehouse.orderpoint" name="create_alert_channel"/>
    </data>
    <data noupdate="1">
        <record id="cron_alerta_stock_diaria" model="ir.cron">
            <field name="name">Inventario: Alerta Diaria de Stock Bajo (OdooBot)</field>
            <field name="model_id" ref="model_stock_warehouse_orderpoint"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_stock_and_notify()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>