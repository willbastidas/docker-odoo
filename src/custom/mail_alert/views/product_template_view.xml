<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_search_view_inherit_stock_alert" model="ir.ui.view">
        <field name="name">product.template.search.inherit.stock.alert</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="stock_min_alert" string="Stock Mínimo"/>
            </xpath>
            <xpath expr="//filter[@name='services']" position="after">
                <separator/>
                <filter string="Stock Crítico (Bajo Mínimo)" 
                        name="stock_below_min"
                        domain="[('stock_min_alert', '>', 0)]"/>
            </xpath>

            <xpath expr="//group" position="inside">
                <separator/>
                <filter string="Cantidad Faltante" 
                    name="group_by_stock_alert" 
                    context="{'group_by': 'stock_min_alert'}"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_view_inherit_stock_alert" model="ir.ui.view">
        <field name="name">product.template.tree.inherit.stock.alert</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_available']" position="after">
                <field name="stock_min_alert" string="Stock Mínimo" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>